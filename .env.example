# ---------------------------------------------------------------------------
# Memento — environment configuration
# Copy to .env and fill in your keys. Everything without a key has a working
# default; the app boots without keys (health/UI/conversations work), but
# chat requires OPENAI_API_KEY and web research requires TAVILY_API_KEY.
# ---------------------------------------------------------------------------

# --- AI (required for chat) -------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Web search (required for current-information research) ----------------
TAVILY_API_KEY=
SEARCH_PROVIDER=tavily

# --- Storage ---------------------------------------------------------------
# SQLite file path; 'file:' prefix optional. Created automatically.
DATABASE_URL=data/memento.db

# --- Temporal reasoning ----------------------------------------------------
# IANA timezone used to resolve "last Tuesday", "since November 3", etc.
APP_TIMEZONE=Asia/Kolkata

# --- Bounded orchestration limits ------------------------------------------
MAX_SEARCH_QUERIES=6
MAX_SEARCH_RESULTS=5
MAX_AGENT_ITERATIONS=3
MAX_RESEARCH_TIME_MS=45000
MAX_TOTAL_TOKENS=60000

# --- Search engine tuning ----------------------------------------------------
SEARCH_TIMEOUT_MS=12000
SEARCH_CACHE_TTL=900
SEARCH_CONCURRENCY=3

# --- HTTP --------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=info
